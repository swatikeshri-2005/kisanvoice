# Copy this file to .env and fill in values from your Gnani AI API documentation.
# Never commit .env or share your API key.

GNANI_API_KEY=
GNANI_STT_URL=
GNANI_TTS_URL=

# Authentication settings; change only if your API documentation requires it.
GNANI_AUTH_HEADER=Authorization
GNANI_AUTH_PREFIX=Bearer 

# STT request/response fields (verify against your account's API documentation).
GNANI_STT_FILE_FIELD=file
GNANI_STT_LANGUAGE_FIELD=language
GNANI_STT_RESPONSE_TEXT_KEY=text

# TTS response JSON audio field (if API returns JSON/base64).
GNANI_TTS_RESPONSE_AUDIO_KEY=audio

# Language codes; confirm the exact accepted values in your Gnani API docs.
GNANI_HINDI_STT_LANGUAGE=hi-IN
GNANI_BENGALI_STT_LANGUAGE=bn-IN
GNANI_HINDI_TTS_LANGUAGE=hi-IN
GNANI_BENGALI_TTS_LANGUAGE=bn-IN

REQUEST_TIMEOUT_SECONDS=45
