{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KisanVoice - Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "KisanVoice - FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.api:app", "--reload"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
